# Copy to .env and fill in. .env is gitignored -- never commit real keys.
# The asset pipeline scripts under Tools/ read these; the shipped game does not
# need any of them at runtime (it is fully offline).

# https://www.meshy.ai -- text-to-3D creature meshes
MESHY_API_KEY=

# https://elevenlabs.io -- sound effects and ambience
ELEVENLABS_API_KEY=

# https://replicate.com -- optional extra texture/image generation
REPLICATE_API_TOKEN=

# https://www.recraft.ai -- interface art (panels, buttons, icons)
RECRAFT_API_KEY=

# AdMob (leave the Google test ids here for development builds)
ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
ADMOB_REWARDED_UNIT_ID=ca-app-pub-3940256099942544/5224354917
ADMOB_INTERSTITIAL_UNIT_ID=ca-app-pub-3940256099942544/1033173712
