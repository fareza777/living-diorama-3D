Tools/.meshy_state.json

# --- Unity -------------------------------------------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Never ignore Unity meta files
!/[Aa]ssets/**/*.meta

# Autogenerated VS/Rider project files
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
