*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Gradle / Android export
[Ee]xport/
.utmp/
.gradle/
*.keystore
!debug.keystore

# --- OS ----------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# Animation carrier FBXs. Each is a full seven-megabyte copy of the creature that
# exists only so a clip can be extracted out of it; the extracted .anim files under
# Assets/Data/Animations are what the game actually uses and those are committed.
# The one kept per creature is the rig the clips bind to.
Assets/Art/Creatures/*/Animations/*.fbx
!Assets/Art/Creatures/*/Animations/*@idle.fbx

# --- Python tooling ----------------------------------------------------------
__pycache__/
*.pyc
.venv/

# Smoke-test output; the one shot the README uses is committed under docs/.
Screenshots/
