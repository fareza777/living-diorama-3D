/* Living Diorama -- interface stylesheet.
 *
 * The world is warm, saturated and busy, so the UI stays dark, quiet and translucent:
 * it frames the diorama rather than competing with it. Everything is built from a small
 * set of tokens below so a colour change is one edit, not forty.
 */

:root {
    --ink: rgb(240, 243, 250);
    --ink-dim: rgba(240, 243, 250, 0.62);
    --ink-faint: rgba(240, 243, 250, 0.34);

    --panel: rgba(18, 20, 32, 0.88);
    --panel-raised: rgba(30, 34, 52, 0.94);
    --panel-sunken: rgba(10, 11, 20, 0.75);
    --stroke: rgba(255, 255, 255, 0.10);
    --stroke-strong: rgba(255, 255, 255, 0.22);

    --gold: rgb(255, 199, 88);
    --teal: rgb(104, 226, 214);
    --violet: rgb(178, 142, 255);
    --danger: rgb(255, 118, 106);
    --success: rgb(126, 226, 140);

    --rarity-common: rgb(158, 166, 184);
    --rarity-uncommon: rgb(126, 214, 138);
    --rarity-rare: rgb(104, 176, 255);
    --rarity-epic: rgb(190, 132, 255);
    --rarity-legendary: rgb(255, 196, 84);

    --radius: 20px;
    --radius-sm: 14px;
    --gap: 10px;

    /* Elevation is expressed as border colour rather than a real shadow, which
       UI Toolkit does not have; two strengths is enough to read a hierarchy. */
    --edge-soft: rgba(255, 255, 255, 0.07);
    --edge-hard: rgba(0, 0, 0, 0.45);
}

/* Everything inherits the body face; titles opt into the serif. */
:root {
    -unity-font-definition: resource("Fonts/Nunito-SemiBold");
}

.title-face {
    -unity-font-definition: resource("Fonts/Cinzel-Bold");
}

.body-bold {
    -unity-font-definition: resource("Fonts/Nunito-Bold");
}

/* ---------------------------------------------------------------- structure */

.root {
    flex-grow: 1;
    /* Leaves room for notches and gesture bars without a plugin. */
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 12px;
    padding-right: 12px;
}

.fill {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.row {
    flex-direction: row;
    align-items: center;
}

.column {
    flex-direction: column;
}

.spacer {
    flex-grow: 1;
}

.hidden {
    display: none;
}

/* ------------------------------------------------------------------- panels */

.panel {
    background-color: var(--panel);
    border-radius: var(--radius);
    border-width: 1px;
    border-color: var(--stroke);
    padding: 14px;
}

.panel--raised {
    background-color: var(--panel-raised);
    border-color: var(--stroke-strong);
}

.scrim {
    background-color: rgba(6, 7, 14, 0.72);
}

.modal {
    align-items: center;
    justify-content: center;
}

.modal__card {
    width: 92%;
    max-width: 520px;
    max-height: 84%;
    background-color: rgba(14, 17, 30, 0.97);
    border-radius: 26px;
    border-width: 2px;
    border-color: rgba(214, 168, 92, 0.42);
    padding: 20px;
}

.modal__title {
    font-size: 30px;
    -unity-font-definition: resource("Fonts/Cinzel-Bold");
    letter-spacing: 1px;
    color: rgb(255, 240, 218);
    margin-bottom: 4px;
}

.modal__subtitle {
    font-size: 16px;
    color: var(--ink-dim);
    margin-bottom: 14px;
    white-space: normal;
}

/* --------------------------------------------------------------------- chips */

.chip {
    flex-direction: row;
    align-items: center;
    background-color: rgba(12, 14, 24, 0.86);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(214, 168, 92, 0.55);
    padding-left: 8px;
    padding-right: 12px;
    padding-top: 5px;
    padding-bottom: 5px;
    margin-right: 7px;
    flex-shrink: 0;
    min-width: 62px;
}

.chip__icon {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    margin-right: 6px;
    flex-shrink: 0;
}

.chip__icon--coins { background-color: var(--gold); }
.chip__icon--essence { background-color: var(--teal); }
.chip__icon--keys { background-color: var(--violet); }

.chip__value {
    font-size: 18px;
    -unity-font-definition: resource("Fonts/Nunito-Bold");
    color: rgb(252, 246, 234);
}

/* -------------------------------------------------------------------- buttons */

/* Buttons are drawn rather than painted.
 *
 * The generated plate art carries an ornament across the middle of the pill, which is
 * handsome on its own and unreadable the moment a word sits on it -- the label lands on
 * top of the ornament and neither wins. A button's first job is to say what it does, so
 * the face is built here instead: a flat brass-edged plate that is exactly symmetrical
 * at any width, with the text centred in it and nothing behind the text at all. The
 * painted art is kept for the icon-only buttons, where there is no label to fight. */
.button {
    min-height: 54px;
    border-radius: var(--radius-sm);
    border-width: 2px;
    border-color: rgba(196, 150, 78, 0.85);
    background-color: rgb(38, 32, 26);
    color: rgb(247, 238, 220);
    font-size: 17px;
    -unity-font-definition: resource("Fonts/Nunito-Bold");
    -unity-text-align: middle-center;
    letter-spacing: 0.5px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 4px;
    padding-bottom: 4px;
    flex-shrink: 1;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}

.button:hover {
    background-color: rgb(52, 43, 33);
}

.button:active {
    scale: 0.97 0.97;
    background-color: rgb(28, 24, 19);
}

.button:hover { background-color: rgba(46, 52, 76, 0.96); }
.button:active { scale: 0.97 0.97; }

.button:disabled {
    opacity: 0.42;
}

.button--primary {
    background-color: rgb(120, 74, 26);
    border-color: rgb(240, 196, 108);
    color: rgb(255, 244, 222);
}

.button--primary:hover {
    background-color: rgb(142, 90, 33);
}

.button--primary:active {
    background-color: rgb(96, 58, 20);
}

.button--primary:hover { background-color: rgb(255, 214, 122); }

.button--ad {
    background-color: rgba(104, 226, 214, 0.18);
    border-color: var(--teal);
    color: var(--teal);
}

/* The secondary action, not a disabled one.
 *
 * These were nearly black next to a bright gold primary, and measured on a phone the
 * label contrast was fine -- 14:1 -- while the buttons still read as greyed out. The
 * problem was never legibility of the text; it was that the plate looked switched off.
 * A lifted face and a brighter rim say "you can press this". */
.button--ghost {
    background-color: rgb(62, 55, 48);
    border-color: rgba(226, 182, 106, 0.75);
    color: rgb(246, 240, 228);
}

.button--ghost:hover {
    background-color: rgb(78, 69, 60);
}

.button--ghost:active {
    background-color: rgb(48, 42, 37);
}

.button--mini {
    min-height: 44px;
    height: 44px;
    padding-left: 12px;
    padding-right: 12px;
    font-size: 15px;
    letter-spacing: 1px;
}

.button--icon {
    width: 54px;
    height: 54px;
    min-height: 54px;
    padding-left: 0;
    padding-right: 0;
    border-radius: 16px;
    font-size: 22px;
}

/* ----------------------------------------------------------------------- HUD */

.hud__top {
    flex-direction: row;
    align-items: flex-start;
}

.hud__clock {
    align-items: flex-end;
    flex-shrink: 0;
    max-width: 46%;
}

.hud__clock-plate {
    align-items: flex-end;
    background-color: rgba(12, 14, 24, 0.86);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(214, 168, 92, 0.55);
    padding: 6px 12px;
}

.hud__clock-label {
    font-size: 16px;
    color: rgb(226, 231, 242);
    -unity-text-align: middle-right;
    white-space: nowrap;
}

.hud__rate {
    font-size: 15px;
    color: var(--gold);
}

/* Three buttons, one row, exact thirds.
 *
 * This used to wrap: the buttons were sized by their own text, would not shrink, and had
 * a growing spacer after them, so on a real phone Expand dropped onto a second line and
 * hung off the tray. Equal shares of the row cannot do that at any width, and the result
 * is symmetrical, which the wrapped version never was. */
.hud__bottom {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-wrap: nowrap;
    background-color: rgba(10, 11, 20, 0.82);
    border-radius: 22px;
    border-width: 1px;
    border-color: rgba(196, 150, 78, 0.30);
    padding: 8px;
}

.tray__button {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    margin-left: 4px;
    margin-right: 4px;
    padding-left: 6px;
    padding-right: 6px;
    min-width: 0;
}

.level {
    width: 168px;
    margin-top: 8px;
}

.level__row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 4px;
}

.level__label {
    font-size: 14px;
    color: rgb(226, 231, 242);
}

/* The level bar sat directly on the sky too. */
.level {
    background-color: rgba(12, 14, 24, 0.80);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(214, 168, 92, 0.38);
    padding: 6px 10px;
    margin-top: 6px;
}

.level__track {
    height: 12px;
    background-color: var(--panel-sunken);
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--edge-soft);
    overflow: hidden;
}

.level__fill {
    height: 100%;
    background-color: var(--gold);
    border-radius: 5px;
    width: 0;
    transition-property: width;
    transition-duration: 0.4s;
}

/* -------------------------------------------------------------------- toasts */

.toasts {
    position: absolute;
    left: 12px;
    bottom: 108px;
    width: 62%;
    max-width: 380px;
}

.toast {
    background-color: var(--panel);
    border-left-width: 3px;
    border-left-color: var(--gold);
    border-radius: 10px;
    padding: 9px 12px;
    margin-top: 6px;
    font-size: 16px;
    color: var(--ink);
    white-space: normal;
    opacity: 1;
    transition-property: opacity, translate;
    transition-duration: 0.35s;
}

.toast--fading {
    opacity: 0;
    translate: -24px 0;
}

/* ----------------------------------------------------------------- creatures */

.card {
    width: 96px;
    margin: 6px;
    align-items: center;
    background-color: var(--panel);
    border-radius: var(--radius-sm);
    border-width: 2px;
    border-color: var(--stroke);
    padding-top: 10px;
    padding-bottom: 10px;
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}

.card:hover { scale: 1.04 1.04; }

.card--locked { opacity: 0.45; }

.card--common { border-color: var(--rarity-common); }
.card--uncommon { border-color: var(--rarity-uncommon); }
.card--rare { border-color: var(--rarity-rare); }
.card--epic { border-color: var(--rarity-epic); }
.card--legendary { border-color: var(--rarity-legendary); }

.card__portrait {
    width: 66px;
    height: 66px;
    border-radius: 12px;
    background-color: var(--panel-sunken);
    margin-bottom: 7px;
}

.card__portrait--unknown {
    background-color: rgba(0, 0, 0, 0.55);
}

/* Two lines' worth of room whether the name needs it or not. "Timber Wolf" wraps
   and "Slime" does not, and a grid whose rows start at different heights depending
   on how long a name happens to be does not read as a grid. */
.card__name {
    font-size: 15px;
    height: 40px;
    -unity-font-style: bold;
    color: var(--ink);
    -unity-text-align: middle-center;
    white-space: normal;
}

.card__count {
    font-size: 14px;
    color: var(--ink-dim);
}

.grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

/* ------------------------------------------------------------------- inspector */

.inspector {
    position: absolute;
    right: 12px;
    bottom: 92px;
    width: 244px;
}

.inspector__name {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--ink);
}

.inspector__species {
    font-size: 15px;
    color: var(--ink-dim);
    margin-bottom: 10px;
}

.need {
    margin-top: 7px;
}

.need__row {
    flex-direction: row;
    justify-content: space-between;
}

.need__label {
    font-size: 14px;
    color: var(--ink-dim);
}

.need__track {
    height: 7px;
    background-color: var(--panel-sunken);
    border-radius: 3px;
    overflow: hidden;
    margin-top: 4px;
}

.need__fill {
    height: 100%;
    border-radius: 3px;
    transition-property: width;
    transition-duration: 0.3s;
}

.need__fill--good { background-color: var(--success); }
.need__fill--warn { background-color: var(--gold); }
.need__fill--bad { background-color: var(--danger); }

/* ----------------------------------------------------------------- box screen */

.box-list {
    flex-direction: column;
}

.box-entry {
    flex-direction: row;
    align-items: center;
    background-color: var(--panel);
    border-radius: var(--radius-sm);
    border-width: 1px;
    border-color: var(--stroke);
    padding: 12px;
    margin-bottom: 10px;
}

.box-entry__art {
    width: 62px;
    height: 62px;
    border-radius: 14px;
    border-width: 2px;
    margin-right: 12px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.box-entry__glyph {
    width: 38px;
    height: 38px;
}

.box-entry__name {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--ink);
}

.box-entry__odds {
    font-size: 14px;
    color: var(--ink-dim);
    white-space: normal;
}

.reveal {
    align-items: center;
    justify-content: center;
    padding-top: 12px;
    padding-bottom: 12px;
}

.reveal__rarity {
    font-size: 15px;
    -unity-font-definition: resource("Fonts/Nunito-Bold");
    letter-spacing: 4px;
}

.reveal__name {
    font-size: 36px;
    -unity-font-definition: resource("Fonts/Cinzel-Bold");
    letter-spacing: 1px;
    color: rgb(255, 241, 220);
    margin-top: 4px;
}

.reveal__flavour {
    font-size: 16px;
    color: var(--ink-dim);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 8px;
}

.reveal__badge {
    background-color: var(--gold);
    color: rgb(30, 22, 6);
    font-size: 14px;
    -unity-font-style: bold;
    border-radius: 999px;
    padding: 3px 10px;
    margin-top: 10px;
}

/* --------------------------------------------------------------- expand screen */

.tile-option {
    flex-direction: row;
    align-items: center;
    background-color: var(--panel);
    border-radius: var(--radius-sm);
    border-width: 1px;
    border-color: var(--stroke);
    padding: 12px;
    margin-bottom: 8px;
}

.tile-option--locked { opacity: 0.5; }

.tile-option__swatch {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    border-width: 2px;
    margin-right: 12px;
    flex-shrink: 0;
}

.tile-option__name {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--ink);
}

.tile-option__meta {
    font-size: 14px;
    color: var(--ink-dim);
    white-space: normal;
}

.tile-option__cost {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--gold);
}

/* ------------------------------------------------------------------- floaters */

.floater {
    position: absolute;
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--gold);
}

/* ------------------------------------------------------------------- splash */
/* First thing anyone sees. Black, one mark, one word, then the world fades up. */

.splash {
    background-color: rgb(8, 9, 14);
    align-items: center;
    justify-content: center;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.9s;
}

.splash--gone {
    opacity: 0;
}

.splash__emblem {
    width: 148px;
    height: 148px;
    opacity: 0;
    scale: 0.86 0.86;
    transition-property: opacity, scale;
    transition-duration: 1.1s;
}

.splash__word {
    font-size: 18px;
    -unity-font-definition: resource("Fonts/Cinzel-SemiBold");
    letter-spacing: 11px;
    color: rgba(255, 214, 150, 0.85);
    margin-top: 18px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 1.1s;
}

.splash--lit .splash__emblem { opacity: 1; scale: 1 1; }
.splash--lit .splash__word { opacity: 1; }

/* -------------------------------------------------------------- title screen */

.title {
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 8%;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.7s;
}

.title--gone {
    opacity: 0;
}

/* A soft floor gradient so the buttons sit on something without hiding the diorama.
   The ramp is a stack of plain colour bands filled in by Scrim: UI Toolkit rejects a
   gradient function here, and a generated texture drew in the editor but not on a
   phone. See Scrim for why this is deliberately the dullest possible implementation. */
.title__vignette {
    flex-direction: column;
}

.title__content {
    align-items: center;
}

.title__emblem {
    width: 132px;
    height: 132px;
    margin-bottom: 6px;
}

.title__name {
    font-size: 42px;
    -unity-font-definition: resource("Fonts/Cinzel-Bold");
    letter-spacing: 10px;
    color: rgb(255, 238, 212);
    margin-top: 4px;
}

.title__tagline {
    font-size: 16px;
    letter-spacing: 3px;
    color: rgba(255, 236, 208, 0.55);
    margin-top: 8px;
    -unity-font-definition: resource("Fonts/Nunito-Regular");
}

.title__credits {
    position: absolute;
    max-width: 460px;
}

/* ------------------------------------------------------------------ subtitle */
/* The narrator is optional listening; the band makes it optional reading too. */

.subtitle {
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: 15%;
    align-items: center;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.subtitle--fading {
    opacity: 0;
}

/* On the title screen the bottom of the frame belongs to the menu, so the narrator's
   line moves up over the diorama instead of running through the Begin button. */
.subtitle--raised {
    bottom: 64%;
}

.subtitle__text {
    background-color: rgba(6, 7, 14, 0.72);
    border-radius: 12px;
    border-width: 1px;
    border-color: var(--stroke);
    padding: 10px 18px;
    font-size: 15px;
    color: rgb(246, 240, 228);
    -unity-text-align: middle-center;
    white-space: normal;
    -unity-font-style: italic;
}

/* --------------------------------------------------------------- reveal card */

.reveal-layer {
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 8%;
    /* Only the card takes input; the 3D reveal behind stays visible and unblocked. */
    background-color: rgba(0, 0, 0, 0);
}

.reveal-card {
    width: 88%;
    max-width: 460px;
    background-color: rgb(13, 15, 25);
    border-radius: 24px;
    border-width: 2px;
    border-color: rgba(214, 168, 92, 0.45);
    padding: 20px;
    align-items: center;
    opacity: 0;
    translate: 0 26px;
    transition-property: opacity, translate;
    transition-duration: 0.45s;
}

.reveal-card--in {
    opacity: 1;
    translate: 0 0;
}

/* ---------------------------------------------------------------- onboarding */

.coach {
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 22%;
}

.coach__card {
    width: 86%;
    max-width: 430px;
    background-color: rgba(14, 16, 26, 0.95);
    border-radius: 20px;
    border-width: 1px;
    border-color: var(--gold);
    padding: 16px 18px;
    opacity: 0;
    translate: 0 18px;
    transition-property: opacity, translate;
    transition-duration: 0.35s;
}

.coach__card--in {
    opacity: 1;
    translate: 0 0;
}

.coach__title {
    font-size: 14px;
    letter-spacing: 4px;
    color: var(--gold);
    -unity-font-definition: resource("Fonts/Nunito-Bold");
}

.coach__body {
    font-size: 15px;
    color: var(--ink);
    white-space: normal;
    margin-top: 6px;
}

/* A ring drawn around whatever the current step wants the player to press. */
.coach__spotlight {
    position: absolute;
    border-width: 2px;
    border-color: var(--gold);
    border-radius: 16px;
    background-color: rgba(255, 199, 88, 0.10);
}

/* ------------------------------------------------------------------ settings */

.setting__label {
    font-size: 15px;
    letter-spacing: 1px;
    color: var(--ink-dim);
    margin-top: 12px;
    margin-bottom: 2px;
}

.setting__slider {
    margin-bottom: 2px;
}

.setting__toggle {
    margin-top: 10px;
    font-size: 16px;
    color: var(--ink);
}

/* --------------------------------------------------------------------- flash */

.flash {
    background-color: rgba(255, 255, 255, 0);
    opacity: 0;
}


/* ---------------------------------------------------------------- scrollbars */

.unity-scroller--vertical,
.unity-scroller--horizontal {
    width: 8px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.unity-scroller--vertical > .unity-scroller__low-button,
.unity-scroller--vertical > .unity-scroller__high-button,
.unity-scroller--horizontal > .unity-scroller__low-button,
.unity-scroller--horizontal > .unity-scroller__high-button {
    display: none;
}

.unity-base-slider--vertical,
.unity-base-slider--horizontal {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin: 0;
}

.unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 0;
    border-radius: 4px;
}

.unity-base-slider__dragger {
    background-color: rgba(214, 168, 92, 0.55);
    border-width: 0;
    border-radius: 4px;
    width: 6px;
    margin-left: 1px;
}

.unity-scroll-view__content-viewport {
    background-color: rgba(0, 0, 0, 0);
}


/* --------------------------------------------------------------- toggles */

/* Unity's default toggle is a white system checkbox, which on a dark card looks like a
   piece of the editor left in by accident. This is the same brass-on-ink language as
   the buttons. */
.unity-toggle__checkmark {
    width: 26px;
    height: 26px;
    border-radius: 7px;
    border-width: 2px;
    border-color: rgba(196, 150, 78, 0.75);
    background-color: rgb(24, 22, 28);
    -unity-background-image-tint-color: rgb(255, 214, 130);
}

.unity-toggle:hover .unity-toggle__checkmark {
    border-color: rgb(240, 196, 108);
}

.unity-toggle > .unity-toggle__input {
    justify-content: flex-start;
}

.unity-toggle .unity-label {
    font-size: 17px;
    color: var(--ink);
    min-width: 190px;
}


/* ------------------------------------------------------------- chronicle */

/* A witnessed moment reads like a page from a field journal: a title, the thing that
   happened, and when. An unseen one is a locked page with a nudge on it. */
.moment {
    flex-direction: row;
    align-items: flex-start;
    background-color: var(--panel);
    border-radius: var(--radius-sm);
    border-width: 1px;
    border-color: var(--stroke);
    padding: 14px;
    margin-bottom: 10px;
}

.moment--found {
    border-color: rgba(226, 182, 106, 0.55);
    background-color: rgba(38, 32, 22, 0.92);
}

.moment__seal {
    width: 46px;
    height: 46px;
    border-radius: 23px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.18);
    background-color: rgba(255, 255, 255, 0.05);
    margin-right: 14px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    font-size: 22px;
    color: var(--ink-faint);
}

.moment__body {
    flex-grow: 1;
    flex-shrink: 1;
}

.moment__title {
    font-size: 18px;
    -unity-font-definition: resource("Fonts/Cinzel-Bold");
    color: rgb(246, 226, 186);
    white-space: normal;
}

.moment__title--locked {
    color: var(--ink-faint);
}

.moment__text {
    font-size: 15px;
    color: var(--ink-dim);
    white-space: normal;
    margin-top: 4px;
}

.moment__reward {
    font-size: 14px;
    color: var(--gold);
    margin-top: 6px;
}

/* A Chronicle entry is not the same as a passing event, so it does not look like one. */
.toast--moment {
    background-color: rgba(58, 44, 18, 0.94);
    border-color: rgba(255, 199, 88, 0.85);
    color: rgb(255, 236, 196);
}

/* ------------------------------------------------------------- viewport */

/* The creature itself, rendered live and turnable. A collection you can only see as
   thumbnails is a spreadsheet; this is the reward for having built them in 3D. */
.viewport {
    height: 250px;
    background-size: 100% 100%;
    border-radius: var(--radius-sm);
    border-width: 1px;
    border-color: rgba(226, 182, 106, 0.45);
    background-color: rgb(13, 14, 23);
    margin-bottom: 12px;
    justify-content: flex-end;
    align-items: center;
    overflow: hidden;
}

/* The inspector fills the screen: the model gets whatever height the text and the
   buttons do not need. */
.modal__card--tall {
    width: 96%;
    max-width: 560px;
    height: 92%;
    max-height: 92%;
}

.viewport--full {
    flex-grow: 1;
    height: auto;
    min-height: 320px;
    margin-bottom: 14px;
}

.viewport__hint {
    font-size: 13px;
    color: var(--ink-faint);
    margin-bottom: 8px;
}

/* --------------------------------------------------------------- odds bar */

.odds {
    flex-direction: row;
    height: 9px;
    border-radius: 5px;
    overflow: hidden;
    margin-top: 8px;
    margin-bottom: 8px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.55);
}

.odds__slice {
    flex-shrink: 1;
    height: 100%;
}
